# Dependencies — avoid sending to Docker daemon (monorepo can be huge)
node_modules
**/node_modules
.npm
.yarn
.pnp
.pnp.js
.yarn-integrity
jspm_packages/

# Lockfiles: keep bun.lock (used by Dockerfile); ignore binary lockfile only if not used
bun.lockb

# Build / cache outputs (Turborepo, Next, Vite, etc.)
.turbo
**/.turbo
.next
**/.next
out
**/out
dist
**/dist
build
**/build
.nuxt
**/.nuxt
.cache
**/.cache
.parcel-cache
**/.parcel-cache
.rpt2_cache
.rts2_cache_cjs
.rts2_cache_es
.rts2_cache_umd
.storybook-out
**/.storybook-out
# Next/static (remove if an app Dockerfile needs public/)
public
**/public

# Environment and secrets (never in image)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Git and VCS
.git
.gitignore
.gitattributes

# IDE and editor
.vscode
.idea
*.swp
*.swo
*~

# Docker (avoid recursive send)
Dockerfile*
docker-compose*.yml
.dockerignore

# Docs and misc (not needed at runtime)
README.md
**/*.md
docs

# Logs and runtime
logs
**/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock
.node_repl_history

# Tests and coverage
coverage
**/coverage
*.lcov
.nyc_output
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/e2e
**/playwright-report
**/test-results

# OS
.DS_Store
Thumbs.db

# ESLint / Prettier cache
.eslintcache
**/.eslintcache

# Optional
tmp
temp
**/tmp
**/temp
*.tgz

# Cursor / agent (optional, reduces context)
.cursor
**/.cursor
