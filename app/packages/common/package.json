{
  "name": "@workspace/common",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo build dist node_modules",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,mdx}\" --ignore-path=\"../../.prettierignore\"",
    "format:fix": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,mdx}\" --ignore-path=\"../../.prettierignore\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "sharp": "0.34.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "vitest": "^2.1.0"
  },
  "prettier": "@workspace/prettier-config",
  "exports": {
    ".": "./src/errors.ts",
    "./api-client": "./src/api-client.ts",
    "./app": "./src/app.ts",
    "./client-ip": "./src/client-ip.ts",
    "./errors": "./src/errors.ts",
    "./guards": "./src/guards.ts",
    "./http": "./src/http.ts",
    "./file-validation": "./src/file-validation.ts",
    "./image": "./src/image.ts",
    "./maybe": "./src/maybe.ts",
    "./server-fetch": "./src/server-fetch.ts"
  }
}
