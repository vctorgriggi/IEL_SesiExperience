{
  "name": "@workspace/email",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo build dist node_modules",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,mdx}\" --ignore-path=\"../../.prettierignore\"",
    "format:fix": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,mdx}\" --ignore-path=\"../../.prettierignore\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "preview": "email dev -d ./src/templates/previews --port 3004",
    "export": "email export -d ./src/templates/previews"
  },
  "dependencies": {
    "@react-email/components": "0.0.41",
    "@react-email/render": "1.1.2",
