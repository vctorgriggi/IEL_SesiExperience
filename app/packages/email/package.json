    "@workspace/common": "workspace:*",
    "nodemailer": "7.0.3",
    "postmark": "4.0.5",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-email": "4.0.16",
    "resend": "4.5.2",
    "zod": "4.4.3"
  },
