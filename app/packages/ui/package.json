  "scripts": {
    "build": "bun run build:css && bun run build:js",
    "build:css": "bunx @tailwindcss/cli -i ./src/styles/globals.css -o ./dist/styles.css --minify",
    "build:js": "bunx tsc",
    "dev": "bunx @tailwindcss/cli -i ./src/styles/globals.css -o ./dist/styles.css --watch",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,mdx}\" --ignore-path=\"../../.prettierignore\"",
    "format:fix": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,mdx}\" --ignore-path=\"../../.prettierignore\"",
    "check:format": "bunx prettier --check '**/*.{js,cjs,mjs,ts,tsx,mdx}' --ignore-path='../../.prettierignore'",
    "fix:format": "bunx prettier --write '**/*.{js,cjs,mjs,ts,tsx,mdx}' --ignore-path='../../.prettierignore'",
    "lint": "bunx eslint . --max-warnings=0 && bun run lint:tokens",
    "fix:lint": "bunx eslint . --fix",
    "typecheck": "bun run types",
    "types": "bunx tsc --noEmit",
    "lint:tokens": "node ./scripts/check-design-tokens.mjs"
  },
