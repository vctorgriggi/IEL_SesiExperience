{
  "name": "@workspace/ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "git clean -xdf .cache .turbo build dist node_modules",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,mdx}\" --ignore-path=\"../../.prettierignore\"",
    "format:fix": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,mdx}\" --ignore-path=\"../../.prettierignore\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/ai"
  },
  "dependencies": {
    "@workspace/billing": "workspace:*",
    "@workspace/database": "workspace:*",
    "@workspace/rate-limit": "workspace:*",
    "server-only": "0.0.1",
    "unpdf": "1.8.0",
    "uuid": "11.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/uuid": "10.0.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*"
  },
  "prettier": "@workspace/prettier-config",
  "exports": {
    ".": "./src/index.ts",
    "./context": "./src/context.ts",
    "./conversations": "./src/conversations.ts",
    "./credit-packs": "./src/credit-packs.ts",
    "./credits": "./src/credits.ts",
    "./demo-quota": "./src/demo-quota.ts",
    "./knowledge": "./src/knowledge.ts",
    "./knowledge-chunking": "./src/knowledge-chunking.ts",
    "./messages": "./src/messages.ts",
    "./rate-limit": "./src/rate-limit.ts"
  }
}
