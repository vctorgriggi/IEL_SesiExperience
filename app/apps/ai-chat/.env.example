# Providers de IA. OPENAI_API_KEY é obrigatória: além dos modelos de chat, os
# embeddings da base de conhecimento usam a OpenAI. ANTHROPIC_API_KEY é
# opcional e adiciona os modelos Claude ao seletor.
OPENAI_API_KEY=sk-placeholder-substituir
# ANTHROPIC_API_KEY=sk-ant-placeholder-substituir

# Base de conhecimento: emails (separados por vírgula) que administram os
# documentos em /knowledge. Admin apaga documento e não gasta cota de demo.
# AI_CHAT_KB_ADMIN_EMAILS=admin@exemplo.com

# Demonstração: cota vitalícia por IP, já que todo visitante entra com a mesma
# conta de exemplo (crie com `bun --cwd packages/database run seed-demo`).
# Esgotada a cota, o app oferece os pacotes de crédito.
# AI_CHAT_DEMO_MESSAGES=3
# AI_CHAT_DEMO_UPLOADS=3

# Mesmo AUTH_SECRET dos outros apps
AUTH_SECRET=altere-um-secret-aleatorio-min-32-chars
# Em produção com subdomínios (app. e chat.), use o mesmo valor do dashboard
# para a sessão ser compartilhada entre os apps.
# AUTH_COOKIE_DOMAIN=.seudominio.com

# Banco (auth usa sessão via DB)
DATABASE_URL=postgresql://arki_user:arki_password@localhost:5432/arki_events

# Rate limit compartilhado entre instâncias. Sem isso a contagem é por
# processo, e num deploy com várias instâncias o teto real vira N vezes maior.
# RATE_LIMIT_REDIS_URL=redis://localhost:6379

# Conversa
# Cota gratuita por usuário (padrão 20)
# AI_CHAT_FREE_MESSAGES=20
# Histórico enviado ao modelo a cada turno (padrão 20 mensagens / 24000 chars)
# AI_CHAT_MAX_CONTEXT_MESSAGES=20
# AI_CHAT_MAX_CONTEXT_CHARS=24000
# Teto de tokens por resposta (padrão 2048)
# AI_CHAT_MAX_OUTPUT_TOKENS=2048
# Instrução do sistema; troque para mudar o tom ou o idioma do assistente
# AI_CHAT_SYSTEM_PROMPT=

# URLs
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
# URL deste app. Sem ela o login não sabe pra onde devolver o usuário.
NEXT_PUBLIC_AI_CHAT_URL=http://localhost:3003
# Opcional (usado quando houver links para o marketing)
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001
NEXT_PUBLIC_THEME_MODE=light

# Email. EMAIL_ETHEREAL cria uma caixa de testes descartável do Nodemailer:
# nada é entregue de verdade e o log imprime a URL para abrir cada mensagem.
# Em produção, troque por um provedor: EMAIL_RESEND_API_KEY,
# EMAIL_POSTMARK_SERVER_TOKEN, EMAIL_SENDGRID_API_KEY ou EMAIL_NODEMAILER_URL.
EMAIL_PROVIDER=nodemailer
EMAIL_FROM=noreply@localhost.local
# EMAIL_ETHEREAL=true
