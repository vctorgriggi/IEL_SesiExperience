# -- Auth --
AUTH_SECRET=altere-um-secret-aleatorio-min-32-chars
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Só em produção com apps em subdomínios diferentes (app.seudominio.com e
# chat.seudominio.com): sem isso o cookie de sessão é host-only e a sessão não
# atravessa. Use o domínio pai com ponto na frente.
# AUTH_COOKIE_DOMAIN=.seudominio.com

# -- Email --
EMAIL_PROVIDER=  # nodemailer | resend 
EMAIL_FROM=
EMAIL_FEEDBACK_INBOX=
EMAIL_RESEND_API_KEY=
EMAIL_NODEMAILER_URL=smtp://user:pass@smtp.example.com:587
# EMAIL_POSTMARK_SERVER_TOKEN=
# EMAIL_SENDGRID_API_KEY=

# -- Banco --
# Dev: localhost. Docker: host postgres na mesma rede.
DATABASE_URL=postgresql://arki_user:arki_password@localhost:5432/arki_events

POSTGRES_DB=arki_events
POSTGRES_USER=arki_user
POSTGRES_PASSWORD=arki_password

# -- Monitoramento 
MONITORING_PROVIDER=console # sentry
MONITORING_SENTRY_ORG=
MONITORING_SENTRY_PROJECT=
MONITORING_SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_MONITORING_SENTRY_DSN=
MONITORING_ALERT_WEBHOOK_URL=

# -- Analytics (opcional) --
NEXT_PUBLIC_ANALYTICS_LOCALHOST=
NEXT_PUBLIC_ANALYTICS_HIMETRICA_API_KEY=
NEXT_PUBLIC_ANALYTICS_HIMETRICA_AUTO_TRACK_PAGE_VIEWS=
NEXT_PUBLIC_ANALYTICS_HIMETRICA_AUTO_TRACK_ERRORS=
NEXT_PUBLIC_ANALYTICS_HIMETRICA_TRACK_VITALS=
NEXT_PUBLIC_ANALYTICS_HIMETRICA_RESPECT_DO_NOT_TRACK=
NEXT_PUBLIC_ANALYTICS_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ANALYTICS_GA_DISABLE_PAGE_VIEWS_TRACKING=
NEXT_PUBLIC_ANALYTICS_POSTHOG_KEY=
NEXT_PUBLIC_ANALYTICS_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_ANALYTICS_UMAMI_HOST=
NEXT_PUBLIC_ANALYTICS_UMAMI_WEBSITE_ID=

# -- Cobrança --
BILLING_PROVIDER=

# Stripe (BILLING_PROVIDER=stripe)
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_WEBHOOK_SECRET=

# Stripe price IDs (catálogo em @workspace/billing)
NEXT_PUBLIC_BILLING_PRICE_PRO_MONTH_ID=
NEXT_PUBLIC_BILLING_PRICE_PRO_YEAR_ID=
NEXT_PUBLIC_BILLING_PRICE_LIFETIME_ID=
NEXT_PUBLIC_BILLING_PRICE_ENTERPRISE_MONTH_ID=
NEXT_PUBLIC_BILLING_PRICE_ENTERPRISE_YEAR_ID=

# AbacatePay (BILLING_PROVIDER=abacatepay): PIX + cartão
BILLING_ABACATEPAY_SECRET_KEY=
BILLING_ABACATEPAY_WEBHOOK_SECRET=
# Legacy aliases (compatibilidade com envs antigos):
# ABACATEPAY_SECRET_KEY=
# ABACATEPAY_WEBHOOK_SECRET=

# -- Chat com IA (créditos) --
# Cota gratuita de mensagens concedida no primeiro acesso (padrão: 20).
# A compra de mais mensagens usa o checkout AbacatePay acima (PIX/cartão).
# AI_CHAT_FREE_MESSAGES=20

# -- Storage (avatar; Cloudinary) --
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -- URLs --
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3001
# Permite o login devolver o usuário pro chat depois de autenticar.
NEXT_PUBLIC_AI_CHAT_URL=http://localhost:3003
# DASHBOARD_URL=http://localhost:3000

# -- CORS & Security Headers  --
ALLOWED_ORIGINS=
# Security: X-Frame-Options. "deny" (default) or "sameorigin" (if you need to embed the app in iframes).
SECURITY_X_FRAME_OPTIONS=deny
# Security: Referrer-Policy (default: strict-origin-when-cross-origin).
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin

# -- Mind RH / Central de Seleção IEL (na raiz do app) --
# Porta da Central: senha única da equipe do IEL. Sem ela definida, a Central abre
# sem login — é como o protótipo roda na máquina de quem desenvolve. Defina em
# produção para a demonstração não ficar aberta na internet. Candidato,
# colaborador e empresa entram por link e nunca passam por esta senha.
# IEL_SENHA_ANALISTA=
#
# O Mind e a análise assistida funcionam sem estas variáveis: no modo padrão
# (nenhuma definida), as respostas saem da regra fixa, sem chamar modelo. Para
# ligar um modelo, defina o provedor E a chave dele; faltando um dos dois,
# continua a regra fixa. Aderência, ranking e corte nunca passam pelo modelo.
# Tudo o que sai para o provedor é pseudonimizado (docs/PRODUTO.md §5).
#
# Gemini, Google (padrão recomendado; chave em aistudio.google.com/apikey):
# IEL_AI_PROVIDER=gemini
# GEMINI_API_KEY=
# Opcional; padrão gemini-3.6-flash (o 2.5-flash não aceita chave nova).
# Alternativa: gemini-2.5-pro, se a chave tiver acesso.
# GEMINI_MODEL=gemini-3.6-flash
#
# DeepSeek (alternativa):
# IEL_AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# Opcional; padrão deepseek-flash. Alternativa: deepseek-v4-pro.
# DEEPSEEK_MODEL=deepseek-flash
#
# Anthropic (alternativa):
# IEL_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
#
# Estado da demonstração no servidor (Neon / Postgres). Sem estas variáveis a
# demo fica no navegador: cada aparelho tem o seu estado, e o que o candidato
# responde no celular NÃO aparece no notebook da analista. Com as três, o
# estado mora numa "sala" no banco e é o mesmo em todos os aparelhos.
#
# 1) DATABASE_URL: a connection string *pooled* do projeto no Neon. Ela já vem
#    com `sslmode=require`, que é o que liga o TLS no cliente — mantenha.
#    (Local, é a mesma DATABASE_URL do bloco "Banco" acima, com o Docker.)
# 2) IEL_ESTADO_COMPARTILHADO=1 liga o modo. Sem DATABASE_URL, não faz nada.
# 3) Uma vez por banco: `bun --filter @workspace/database migrate`
#    (cria as tabelas iel_demo_salas e iel_demo_eventos).
# Veja docs/deploy-checklist.md, "Mind RH com Neon".
# IEL_ESTADO_COMPARTILHADO=1

# -- Mapa --
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

NEXT_PUBLIC_THEME_MODE=light

# -- Build
SENTRY_SUPPRESS_TURBOPACK_WARNING=1
