{
  "name": "@workspace/dashboard",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000 --turbo",
    "dev:dashboard": "bun run dev",
    "build": "next build",
    "start": "next start --port 3000",
    "analyze": "BUNDLE_ANALYZE=both next build --turbo",
    "clean": "git clean -xdf .next .turbo build dist node_modules .cache && rm -f bun.lockb",
    "format": "prettier --check \"**/*.{js,cjs,mjs,ts,tsx,mdx}\" --ignore-path=\"../../.prettierignore\"",
    "format:fix": "prettier --write \"**/*.{js,cjs,mjs,ts,tsx,mdx}\" --ignore-path=\"../../.prettierignore\"",
    "lint": "bunx eslint . --max-warnings=0",
    "fix:lint": "bunx eslint . --fix",
    "typecheck": "bun run types",
    "types": "bunx tsc --noEmit",
    "test": "bunx vitest run --root ../.. --config vitest.config.ts apps/dashboard",
    "test:e2e": "playwright test",
    "e2e:web": "cd ../.. && bun run tools/e2e/e2e-webserver.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.1.0",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.5",
    "@internationalized/date": "^3.11.0",
    "@number-flow/react": "^0.6.0",
    "@t3-oss/env-nextjs": "0.13.6",
    "@tanstack/react-table": "8.21.3",
    "@workspace/ai": "workspace:*",
    "@workspace/analytics": "workspace:*",
    "@workspace/auth": "workspace:*",
    "@workspace/billing": "workspace:*",
    "@workspace/charts": "workspace:*",
    "@workspace/common": "workspace:*",
    "@workspace/database": "workspace:*",
    "@workspace/email": "workspace:*",
    "@workspace/monitoring": "workspace:*",
    "@workspace/rate-limit": "workspace:*",
    "@workspace/routes": "workspace:*",
    "@workspace/storage": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@yudiel/react-qr-scanner": "^2.5.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "file-saver": "2.0.5",
    "leaflet": "^1.9.4",
    "mapbox-gl": "^3.8.0",
    "markdown-it": "14.1.0",
    "next": "15.5.20",
    "next-safe-action": "8.0.2",
    "next-secure-headers": "2.2.0",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "2.4.3",
    "otplib": "12.0.1",
    "qrcode": "1.5.4",
    "react": "19.0.0",
    "react-aria": "^3.46.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.57.0",
    "react-is": "19.0.0",
    "react-leaflet": "^5.0.0",
    "react-map-gl": "^8.0.0",
    "sanitize-html": "2.17.0",
    "server-only": "0.0.1",
    "sharp": "0.34.2",
    "turndown": "7.2.0",
    "uuid": "11.1.0",
    "vaul": "1.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.826.0",
    "@next/bundle-analyzer": "15.5.20",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/file-saver": "2.0.7",
    "@types/leaflet": "^1.9.21",
    "@types/mapbox-gl": "^3.4.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.15.30",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@types/sanitize-html": "2.16.0",
    "@types/turndown": "5.0.5",
    "@types/uuid": "10.0.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14"
  },
  "prettier": "@workspace/prettier-config"
}
